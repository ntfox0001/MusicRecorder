<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>10</LangVersion>
    <RootNamespace>Mt3</RootNamespace>
    <AssemblyName>Mt3</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.18.1" />
    <PackageReference Include="System.Numerics.Tensors" Version="8.0.0" />
  </ItemGroup>

  <!-- MT3 mel filterbank and window (embedded) -->
  <ItemGroup>
    <EmbeddedResource Include="mel_filterbank.bin" />
    <EmbeddedResource Include="mel_window.bin" />
  </ItemGroup>

</Project>
