<Window x:Class="Mp3ToSheet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MP3 → 乐谱 (Basic Pitch)" Height="560" Width="760"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 文件选择 -->
        <GroupBox Grid.Row="0" Header="输入 MP3" Padding="10" Margin="0,0,0,10">
            <DockPanel>
                <Button x:Name="BtnBrowse" Content="浏览..." Width="90"
                        DockPanel.Dock="Right" Click="BtnBrowse_Click"/>
                <TextBox x:Name="TxtInput" Margin="0,0,10,0"
                         IsReadOnly="True" VerticalContentAlignment="Center"/>
            </DockPanel>
        </GroupBox>

        <!-- 参数 -->
        <GroupBox Grid.Row="1" Header="检测参数" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="帧激活阈值:" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtThreshold" Grid.Column="1" Text="0.3"
                         Margin="8,0,0,0" VerticalContentAlignment="Center"/>
            </Grid>
        </GroupBox>

        <!-- 转换按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="BtnConvert" Content="开始转换" Width="120" Height="34"
                    Click="BtnConvert_Click"/>
            <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" Margin="14,0,0,0"
                       Foreground="Gray"/>
        </StackPanel>

        <!-- 日志 -->
        <GroupBox Grid.Row="3" Header="运行日志" Padding="6" Margin="0,0,0,10">
            <TextBox x:Name="TxtLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                     Background="#1e1e1e" Foreground="#d4d4d4"/>
        </GroupBox>

        <!-- 输出 -->
        <GroupBox Grid.Row="4" Header="输出文件" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="MIDI:" Width="130" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtMidiOut" VerticalAlignment="Center" Foreground="#0a7"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
